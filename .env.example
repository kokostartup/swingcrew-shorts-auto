# Google / Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouTube
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

# Notion
NOTION_TOKEN=
NOTION_SHORTS_DB_ID=

# Buffer (DEPRECATED — 직접 API로 교체 예정)
BUFFER_ACCESS_TOKEN=
# 비우면 첫 organization 자동 사용
BUFFER_ORGANIZATION_ID=

# Meta Graph API — Facebook Page 게시용 (메인 Meta App credentials)
# developers.facebook.com → App 생성 → "페이지의 모든 부분 관리" use case
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# Facebook Page ID (영빈 SwingCrew 페이지)
FB_PAGE_ID=

# Instagram API setup with Instagram login — 별도 OAuth flow + 별도 credentials.
# Meta App 안의 Instagram use case "맞춤 설정"에서 별도 발급. Test User 등록 필요.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business Account ID (Graph API me 호출 결과)
IG_USER_ID=

# Threads API — 별도 OAuth (Meta App과 분리). 같은 App 안에 Threads use case 추가해도
# credentials은 별도 발급 (앱 대시보드 → Threads use case → 맞춤 설정).
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
# Threads User ID (GET https://graph.threads.net/v1.0/me 호출 결과)
THREADS_USER_ID=

# TikTok Content Posting API
# developers.tiktok.com → App 등록 → Content Posting API 신청 + 승인 (수일~)
# 승인 후 OAuth flow로 access/refresh token 발급
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# 영빈 TikTok 계정 open_id (OAuth me 호출 결과)
TIKTOK_OPEN_ID=

# Cloudflare R2 (mp4 호스팅 — Buffer가 외부 URL fetch 위해 필요)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_S3_ENDPOINT=

# 폰트 (영빈이 추가)
FONT_PATH=app/utils/fonts/Pretendard-Black.otf

# 저장 경로
SQLITE_PATH=data/state.db
OUTPUT_DIR=outputs

# 인코더 (false=libx264 화질 우선, true=h264_nvenc 속도 우선)
USE_NVENC=false
